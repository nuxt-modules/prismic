{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 80,
	"sortImports": {
		"customGroups": [
			{ "groupName": "vitest", "elementNamePattern": ["vitest", "vitest/**"] }
		],
		"groups": [
			"vitest",
			"builtin",
			["external", "internal", "subpath"],
			["parent", "sibling", "index"],
			"unknown"
		]
	},
	"sortPackageJson": false,
	"ignorePatterns": ["CHANGELOG.md"]
}
